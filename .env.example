# ===========================================================================
# Vayalavan — THE environment file.
#
#   cp .env.example .env
#
# One file. Every service, every Vite config, and docker-compose read their
# variables from here. There are no per-service .env files: a value that
# appears in two places is a value that will disagree in two places.
#
# Everything below is a LOCAL-ONLY development credential. Never reuse any of
# it outside a developer laptop, and never commit .env.
#
# Naming: variables are prefixed by the service that owns them
# (PROFILE_PORT, CATALOG_DATABASE_URL). Unprefixed variables are genuinely
# shared by everything (APP_ENV, LOG_LEVEL, INTERNAL_SERVICE_TOKEN).
# ===========================================================================

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------

# development | staging | production
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=debug
# All business-day logic is computed in IST regardless (CLAUDE.md rule 2);
# this only affects how timestamps render in tool output.
TZ=Asia/Kolkata

# Proves a request came from the gateway (CLAUDE.md rule 5). The gateway
# sends it; all three Go services require it. One value, shared by all four.
# Generate a real one with: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=local_dev_internal_token

# Signs and verifies access tokens. vm-profile-api mints, the gateway
# verifies, so both read this same value.
# Generate a real one with: openssl rand -hex 32
JWT_SECRET=local_dev_jwt_secret_change_me

# How long graceful shutdown waits for in-flight requests.
SHUTDOWN_TIMEOUT=15s

# ---------------------------------------------------------------------------
# Ports — the platform port map
#
# Changing a UI port means changing CORS_ALLOWED_ORIGINS too.
# ---------------------------------------------------------------------------

GATEWAY_PORT=8080
PROFILE_PORT=8081
CATALOG_PORT=8082
ORDERS_PORT=8083
# The analytics pipeline (CLAUDE.md §5.4): the CDC consumer that projects
# supplier, product and order events into the analytics schema, and the read-only API
# the admin Analytics page queries through the gateway.
EVENTS_CONSUMER_PORT=8084
ANALYTICS_API_PORT=8085

CLIENT_UI_PORT=5173
ADMIN_UI_PORT=5174
SUPPLIER_UI_PORT=5175
# vm-analytics-ui, the Analytics remote. Only vm-admin-ui loads it, from the
# admin origin, so it needs no CORS_ALLOWED_ORIGINS entry: it never calls the
# gateway from its own origin.
ANALYTICS_UI_PORT=5176
# The remote's public origin, ending in "/". Its chunks are loaded by the
# ADMIN page, so they are addressed absolutely. Unset locally = localhost:
# ANALYTICS_UI_PORT. Production sets it (see .env.production.example).
ANALYTICS_UI_PUBLIC_URL=

# The Expo/Metro dev servers for the two mobile apps.
#
# NOT Metro's default of 8081 — that is vm-profile-api's port, and with the
# stack up Expo would either fail to bind or silently slide to another port,
# leaving the QR code pointing at nothing.
#
# One port each, so both apps can run at once: a grower who also shops has both
# installed, and testing that they do not fight over a session needs both dev
# servers up together.
MOBILE_METRO_PORT=8090
MOBILE_CLIENT_METRO_PORT=8091

POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

# Container image tags, pinned via env so an upgrade is a config change.
POSTGRES_IMAGE_TAG=16-alpine
MINIO_IMAGE_TAG=latest
MAILHOG_IMAGE_TAG=latest

# Superuser. Owns the database and runs the init scripts that create the
# per-service roles. Application services NEVER use this account.
POSTGRES_USER=vayal_admin
POSTGRES_PASSWORD=local_dev_postgres_pw
POSTGRES_DB=vayal
POSTGRES_HOST=localhost

# Per-service roles. Each OWNS exactly one schema and cannot read the others
# (infra/postgres/init/01-init.sh). This is what enforces "a service may only
# touch its own schema" (CLAUDE.md §3) in Postgres rather than by convention.
PROFILE_DB_USER=vm_profile
PROFILE_DB_PASSWORD=local_dev_profile_pw
CATALOG_DB_USER=vm_catalog
CATALOG_DB_PASSWORD=local_dev_catalog_pw
ORDERS_DB_USER=vm_orders
ORDERS_DB_PASSWORD=local_dev_orders_pw
# The analytics roles (infra/postgres/init/03-analytics.sh):
#   ANALYTICS_DB_USER         owns the `analytics` schema; vm-events-consumer-api
#                             migrates and writes it, and can reach nothing else.
#   ANALYTICS_READER_DB_USER  SELECT on `analytics` only, read-only by default.
#                             vm-analytics-api's role — the analytics user never
#                             sees profile, catalog or orders.
#   EVENTS_CDC_DB_USER        REPLICATION login; SELECT on exactly the two
#                             event outbox tables and nothing else.
ANALYTICS_DB_USER=vm_analytics
ANALYTICS_DB_PASSWORD=local_dev_analytics_pw
ANALYTICS_READER_DB_USER=vm_analytics_reader
ANALYTICS_READER_DB_PASSWORD=local_dev_analytics_reader_pw
EVENTS_CDC_DB_USER=vm_events_cdc
EVENTS_CDC_DB_PASSWORD=local_dev_events_cdc_pw

# Connection strings. Each service reads only its own. search_path is set
# explicitly so unqualified table names resolve to the owning schema even if
# the role default is ever changed.
PROFILE_DATABASE_URL="postgres://vm_profile:local_dev_profile_pw@localhost:5432/vayal?sslmode=disable&search_path=profile,public"
CATALOG_DATABASE_URL="postgres://vm_catalog:local_dev_catalog_pw@localhost:5432/vayal?sslmode=disable&search_path=catalog,public"
ORDERS_DATABASE_URL="postgres://vm_orders:local_dev_orders_pw@localhost:5432/vayal?sslmode=disable&search_path=orders,public"
EVENTS_CONSUMER_DATABASE_URL="postgres://vm_analytics:local_dev_analytics_pw@localhost:5432/vayal?sslmode=disable&search_path=analytics,public"
# The logical-replication connection. `replication=database` is what makes
# Postgres accept replication commands on it; the role needs REPLICATION.
EVENTS_CONSUMER_REPLICATION_URL="postgres://vm_events_cdc:local_dev_events_cdc_pw@localhost:5432/vayal?sslmode=disable&replication=database"
ANALYTICS_API_DATABASE_URL="postgres://vm_analytics_reader:local_dev_analytics_reader_pw@localhost:5432/vayal?sslmode=disable"

# Per-service pool ceiling. Keep the sum well under Postgres max_connections.
DB_MAX_CONNS=10

# ---------------------------------------------------------------------------
# Analytics events — outbox + CDC (CLAUDE.md §5.4)
# ---------------------------------------------------------------------------

# The replication slot and publication vm-events-consumer-api reads. The
# publication is created by `make cdc-setup`; the slot by the consumer on
# first start. Renaming either orphans the old slot, which then retains WAL
# until max_slot_wal_keep_size (docker-compose.yml) — drop it by hand.
CDC_SLOT_NAME=vayal_analytics
CDC_PUBLICATION=vayal_analytics
# How often the consumer reports its position to Postgres when idle.
CDC_STATUS_INTERVAL_SECONDS=10
# How long vm-catalog-api and vm-orders-api keep event rows after writing
# them. CDC reads the WAL, not the table, so this is only a replay window.
OUTBOX_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# MinIO / object storage
#
# ONE endpoint value, used both for signing URLs server-side and for the
# browser that follows them. This works because the Go services run natively
# on the host, not in Docker — so "localhost:9000" means the same thing to
# vm-catalog-api and to the browser.
#
# That is the whole reason presigned PUT/GET need no URL rewriting. If the
# services ever move into Docker they would sign for "minio:9000", the
# browser could not resolve it, and the signature (which covers the Host
# header) would break the moment anything rewrote the host. See the README
# section "Why one MinIO endpoint".
#
# TESTING ON A PHONE: "localhost" is the third address that means something
# different to a handset, alongside Metro's and the gateway's. An image URL
# signed for localhost:9000 sends the phone to ITSELF — the customer app shows
# the placeholder on every card, and the supplier app's presigned upload never
# lands, so a product saves with no photo. `make -C infra mobile-ip` moves
# S3_ENDPOINT to this machine's LAN address along with MOBILE_API_BASE_URL,
# which keeps the one-endpoint rule intact: the LAN address is reachable from
# the laptop's browser too. Restart vm-catalog-api afterwards — the endpoint is
# read once at startup.
# ---------------------------------------------------------------------------

MINIO_ROOT_USER=vayal_minio_admin
MINIO_ROOT_PASSWORD=local_dev_minio_pw
MINIO_BUCKET=mikrogreenz

# minio | s3. Switching to real S3 is a config change, never a code change.
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mikrogreenz
S3_ACCESS_KEY=vayal_minio_admin
S3_SECRET_KEY=local_dev_minio_pw
# MinIO requires path-style addressing; real S3 prefers virtual-host style.
S3_FORCE_PATH_STYLE=true
# How long a presigned upload/download URL stays valid.
S3_PRESIGN_PUT_TTL=15m
S3_PRESIGN_GET_TTL=1h

# ---------------------------------------------------------------------------
# Email (MailHog locally — captures everything, delivers nothing)
# ---------------------------------------------------------------------------

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Vayalavan <no-reply@vayalmikrogreenz.com>"
SUPPORT_EMAIL=vayal.mikrogreenz@gmail.com

# ---------------------------------------------------------------------------
# vm-gateway-api
# ---------------------------------------------------------------------------

# Browser origins allowed to call the API — the three UIs. Keep in sync with
# the UI ports above.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Internal service base URLs. Never public.
PROFILE_API_URL=http://localhost:8081
CATALOG_API_URL=http://localhost:8082
ORDERS_API_URL=http://localhost:8083
# vm-analytics-api (Python). Served under /api/analytics, to admins and
# analysts only.
ANALYTICS_API_URL=http://localhost:8085

RATE_LIMIT_WINDOW_MS=60000
# Requests allowed per IP per window.
#
# Per-IP, so this is shared by everyone behind one address: a household, an
# office, a mobile carrier's NAT. 120/min (2 per second) sounded prudent and
# was not — a single catalogue page load is a burst of API calls, and the
# end-to-end suite tripped it from one machine. Tune per deployment once real
# traffic shapes are known; lower it behind a CDN that already absorbs bursts.
RATE_LIMIT_MAX=600

# ---------------------------------------------------------------------------
# vm-profile-api
# ---------------------------------------------------------------------------

JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
# bcrypt work factor. CLAUDE.md §5.1 specifies 12; accepted range is 10-15.
BCRYPT_COST=12

# Origin used to build supplier set-password links emailed by vm-profile-api.
# Points at the supplier UI, so the link lands on its set-password screen.
SUPPLIER_APP_URL=http://localhost:5175

# ---------------------------------------------------------------------------
# Seed accounts (make seed)
#
# Local development credentials only. CLAUDE.md rule 4 keeps these out of the
# .sql files, so a real deployment simply never sets them and seeds nothing.
# ---------------------------------------------------------------------------

SEED_ADMIN_EMAIL=admin@vayal.test
SEED_ADMIN_PHONE=9700000001
SEED_ADMIN_PASSWORD=local_dev_admin_pw_change_me
SEED_SUPPLIER_PASSWORD=local_dev_supplier_pw
SEED_CUSTOMER_PASSWORD=local_dev_customer_pw
# A dev analyst: signs in to the admin console and sees only Analytics.
SEED_ANALYST_EMAIL=analyst@vayal.test
SEED_ANALYST_PHONE=9700000002
SEED_ANALYST_PASSWORD=local_dev_analyst_pw

# ---------------------------------------------------------------------------
# vm-catalog-api
# ---------------------------------------------------------------------------

# Upload limits (CLAUDE.md §6.5, §6.6).
# One product image: 5 MB. The supplier apps downscale before uploading, so
# this is only reached by a photo that is still huge after a resize.
MAX_IMAGE_BYTES=5242880
# One product video: 50 MB. An order of magnitude larger because even a
# ten-second clip off a phone is tens of megabytes, and a limit a grower trips
# on every attempt is a feature they stop using. Nothing transcodes video, so
# this is the real ceiling — the supplier app caps recording at 30s to stay
# inside it.
MAX_VIDEO_BYTES=52428800
# Images plus videos per SIZE CODE. Per grade, not per product, because that is
# where a gallery lives — a product graded M/L/XL legitimately carries three
# sets of photographs.
MAX_MEDIA_PER_SIZE_CODE=8
# Grades per product. A grower has a handful; this stops a runaway client.
MAX_SIZE_CODES_PER_PRODUCT=12
MAX_CSV_BYTES=5242880
MAX_CSV_ROWS=2000

# The markup a NEW product starts on, in basis points: 500 = 5.00%.
#
# A percentage of the grower's price, added on top and charged to the customer
# (a ₹1,000 pack sells for ₹1,050). It is OURS — suppliers never see it, are
# never paid it, and are never charged commission on it.
#
# Applies at creation only. Changing this does not reprice produce an admin has
# already set a markup on; that is done per product on the admin Products
# screen. 0 disables markup on new produce entirely.
PRODUCT_MARKUP_DEFAULT_BPS=500

# ---------------------------------------------------------------------------
# vm-orders-api
# ---------------------------------------------------------------------------

# Platform fee in basis points. 300 = 3.00%. Integer basis points keep the
# rate exact so no float touches a fee calculation (CLAUDE.md rule 1).
PLATFORM_FEE_BPS=300
# Flat delivery charge in paise. 1500 = Rs. 15.00.
DELIVERY_FEE_PAISE=1500
# Deducted from the SUPPLIER's payout (not added to the customer's total, the
# way PLATFORM_FEE_BPS is). 300 = 3.00%. Set to 0 to pay growers in full.
SUPPLIER_COMMISSION_BPS=300
# Our share of DELIVERY_FEE_PAISE; the rest is the courier's cost.
# 500 = Rs. 5.00 of the Rs. 15.00 collected. Must not exceed DELIVERY_FEE_PAISE.
DELIVERY_MARGIN_PAISE=500
# Daily order cutoff hour, IST, 24-hour clock. Range 0-23.
#
# One setting, three behaviours: it decides each order's processing date and
# therefore its delivery dates (CLAUDE.md §6.1), it is when the processor
# promotes paid orders to processed, and it is the earliest the daily courier
# report is emailed. Move it and all three move together — the report exists to
# describe what the cutoff decided, so they should never drift apart.
ORDER_CUTOFF_HOUR_IST=16
# When an order may be marked DISPATCHED automatically on its delivery day.
# IST, 24-hour clock, range 0-23.
#
# 0 (the default) dispatches as soon as the delivery day begins — just after
# midnight. Set it to the hour the courier actually collects, e.g. 9, so the
# customer is not told their food is on its way while the box is still here.
# Orders whose delivery day has already passed wait for the same hour, so they
# go out with the morning run rather than at 3am.
#
# Deliberately NOT the same setting as ORDER_CUTOFF_HOUR_IST: that one is an
# afternoon deadline for taking orders, this is a morning collection.
DISPATCH_HOUR_IST=0
# How long held stock survives without payment before the sweeper releases it.
RESERVATION_TTL_MINUTES=15
# How often the job checks for orders whose 4pm cutoff has passed. This is the
# worst-case lag between an order becoming due and being processed, not a
# schedule — see the Processor type in vm-orders-api/internal/api. Accepted
# range is 5-3600; anything outside it stops the service at boot.
ORDER_PROCESSOR_INTERVAL_SECONDS=60
# The same tick also DISPATCHES orders whose delivery day has arrived, so an
# order nobody dispatched by hand stops telling the customer it is still being
# prepared. An admin can still dispatch earlier from the fulfilment queue.

# --- Wallet and scheduled orders (CLAUDE.md §6.7) ----------------------------
#
# The prepaid wallet customers top up through Razorpay. All amounts in paise.
# Top-ups outside [MIN, MAX] are refused; a top-up that would take the balance
# past MAX_BALANCE is refused too. Closed-loop: the balance is only spent here,
# or refunded by an admin to the payment it came from.
WALLET_MIN_TOPUP_PAISE=10000
WALLET_MAX_TOPUP_PAISE=1000000
WALLET_MAX_BALANCE_PAISE=2000000
# Scheduled deliveries are charged from the wallet this many minutes BEFORE the
# cutoff of their processing day (two days before the expected delivery), so
# the order is processed that day like any other. It is also the moment the
# customer can no longer skip or edit that date. Range 5-180.
SCHEDULE_CHARGE_LEAD_MINUTES=30
# Deliveries skipped in a row for want of balance before a schedule pauses.
SCHEDULE_LOW_BALANCE_PAUSE_AFTER=3
# How often the charging run looks for due schedules. Range 10-900.
SCHEDULE_RUN_INTERVAL_SECONDS=60

# --- The daily courier report -----------------------------------------------
#
# Once the 4pm run has decided what is being packed, the day's courier sheet is
# emailed as a CSV attachment. Sent once per IST day — the guard is a row in
# orders.daily_report_sends, so restarts and replicas cannot duplicate it.
#
# WHEN: from ORDER_CUTOFF_HOUR_IST onwards (above), on the first processor tick
# that finds anything waiting to be dispatched. There is no schedule of its own.
#
# MAIL_TO is the switch: leave it EMPTY and the job does not run, which is what
# a developer's machine wants. Set it to a comma-separated list to turn it on.
MAIL_TO=
# The subject line. The report's own date is appended to it.
MAIL_SUBJECT=Vayal Daily Orders Report
# The account the report is sent FROM, and the account it authenticates as.
MAIL_FROM=
# A Gmail APP PASSWORD, not the account password — Google requires one for SMTP
# with 2FA on. Generate at https://myaccount.google.com/apppasswords.
# NEVER commit the real value: the real .env is gitignored for this reason.
MAIL_APP_PASSWORD=
# Gmail's submission endpoint. Port 587 is STARTTLS, which is what this service
# negotiates; 465 (implicit TLS) will NOT work.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
#
# These are deliberately separate from SMTP_* above. That relay points at
# MailHog in development so no order confirmation ever escapes a laptop; this
# report is meant to reach real inboxes, and one relay cannot be both.

# Razorpay test-mode keys. NEVER commit real values.
#
# Test mode needs no KYC — rzp_test_* keys work from the moment the account
# exists; activation gates only live keys and real settlement.
#
# RAZORPAY_KEY_ID must equal VITE_RAZORPAY_KEY_ID below. The order is created
# under the server's key and Checkout has to open under the SAME one, so a
# stale value there fails every payment. To check a pair authenticates:
#   curl -s -o /dev/null -w '%{http_code}\n' \
#     -u "$RAZORPAY_KEY_ID:$RAZORPAY_KEY_SECRET" \
#     'https://api.razorpay.com/v1/orders?count=1'
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=local_dev_razorpay_secret
# Separate secret, configured per-webhook in the Razorpay dashboard. Verifies
# X-Razorpay-Signature against the RAW request body.
#
# The webhook is the ONLY thing that marks an order paid. Razorpay cannot reach
# localhost, so on a laptop the gateway needs a tunnel (cloudflared / ngrok) and
# https://<public-host>/webhooks/razorpay registered in the dashboard —
# otherwise every test order sits in pending_payment. See README,
# "Testing payments locally".
RAZORPAY_WEBHOOK_SECRET=local_dev_razorpay_webhook_secret
# How many deliveries of ONE webhook event may fail for a temporary reason (a
# database blip, a restart) before it is closed as failed and left to a human.
# Until then a 5xx asks Razorpay to redeliver, and the redelivery is processed
# again. Permanent failures (an amount mismatch) are closed on the first try.
# Range 1-100.
WEBHOOK_MAX_ATTEMPTS=10

# The tunnel that makes the webhook reachable. `./start.sh --tunnel` starts it,
# waits for the hostname to answer, and prints the URL to register.
#
# Blank provider = whichever of cloudflared / ngrok is installed. Blank name and
# hostname = a QUICK tunnel: it works immediately, needs no account, and gets a
# NEW random hostname on every run — which means re-pointing the dashboard
# webhook every run.
#
# To stop doing that, give the tunnel a fixed hostname and register it once:
#   cloudflared — needs a domain on Cloudflare. One-time:
#       cloudflared tunnel create vayal-dev
#       cloudflared tunnel route dns vayal-dev vayal-dev.example.com
#     then set DEV_TUNNEL_NAME=vayal-dev and DEV_TUNNEL_HOSTNAME to that host.
#   ngrok — the free tier includes one reserved domain. Set DEV_TUNNEL_HOSTNAME
#     to it (DEV_TUNNEL_NAME is ignored).
#
# Development only. Nothing here is read in production, where the gateway has a
# real public hostname.
DEV_TUNNEL_PROVIDER=
DEV_TUNNEL_NAME=
DEV_TUNNEL_HOSTNAME=

# cloudflared's transport. It prefers QUIC, which needs long-lived outbound UDP;
# on a network that mangles or idle-drops that, the control stream fails until
# Cloudflare deregisters the hostname — and the symptom is a cloudflared process
# that is still running while Razorpay rejects the URL with "no such host".
# Blank means http2, which is the documented fallback and survives such
# networks. Set to `quic` or `auto` to use cloudflared's own preference.
DEV_TUNNEL_PROTOCOL=

# ---------------------------------------------------------------------------
# Frontends
#
# WARNING: every VITE_-prefixed value is compiled into the browser bundle and
# is therefore PUBLIC. Never put a secret here. The Razorpay key ID belongs;
# the key secret never does.
# ---------------------------------------------------------------------------

# Includes the /api mount point — the gateway serves the JSON API under
# /api, and everything else (health probes, the Razorpay webhook) at the root.
VITE_API_BASE_URL=http://localhost:8080/api
# Must equal RAZORPAY_KEY_ID above — see the note there. Public by design.
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
VITE_SUPPORT_EMAIL=vayal.mikrogreenz@gmail.com
VITE_APP_NAME="Vayalavan"
# Where vm-admin-ui fetches vm-analytics-ui's Module Federation entry from.
# Required by the admin build. Must agree with ANALYTICS_UI_PORT locally; in
# production it is the analytics UI's public URL + /remoteEntry.js.
VITE_ANALYTICS_REMOTE_URL=http://localhost:5176/remoteEntry.js

# ---------------------------------------------------------------------------
# The mobile apps (React Native / Expo — Android and iOS)
#
#   vm-supplier-mobile-ui  "Vayalavan Supplier"      — the grower's app
#   vm-client-mobile-ui    "Vayalavan"   — the customer's app
#
# Read by each app.config.ts at BUILD time and baked into the app binary, so
# these cannot be changed after a build the way a server's environment can.
# Like the VITE_ values above, everything here ships inside the app and is
# PUBLIC.
#
# EAS builds do not see this file — they upload only the app directory. Set the
# same variables as EAS environment variables (`eas env:create`) for anything
# built in the cloud. See each app's README.md.
# ---------------------------------------------------------------------------

# The gateway AS THE PHONE SEES IT, including the /api mount point.
#
# Shared by both apps: one gateway, one address. `make -C infra mobile-ip`
# rewrites this line to your machine's current LAN address.
#
# "localhost" here means the handset itself, not your laptop, so the default
# below only works in a simulator on the same machine. On a real device — which
# is the only way to test the camera — set your machine's LAN address, e.g.
# http://192.168.1.20:8080/api. `ipconfig getifaddr en0` prints it on macOS.
#
# The device and the laptop must be on the same network, and CORS does not
# apply: a native app sends no Origin header, so no allow-list change is needed.
MOBILE_API_BASE_URL=http://localhost:8080/api

# The EAS project ids, written by `eas init`. One per app: two bundle ids, two
# store listings, two projects. Empty is fine for `expo start` and for local
# `run:android` / `run:ios`; only cloud builds need them.
MOBILE_EAS_PROJECT_ID=
MOBILE_CLIENT_EAS_PROJECT_ID=

# Where the web storefront is published, e.g. https://vayalmikrogreenz.com
#
# The customer app links out to its policy pages — terms, privacy, shipping,
# refunds — rather than shipping a second copy of the legal text that would
# then drift from the published one. Optional: left empty, the app simply
# hides those links. Set it before submitting to either store, both of which
# want a reachable privacy policy.
MOBILE_STOREFRONT_URL=
