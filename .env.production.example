# Production environment for docker-compose.prod.yml.
#
#   cp .env.production.example .env.production   # then fill in every value
#   docker compose -f infra/docker-compose.prod.yml --env-file .env.production up -d
#
# .env.production is gitignored. Nothing in this file is a real secret, and
# every placeholder below MUST be replaced — the compose file refuses to start
# rather than silently defaulting the ones that matter.
#
# Generate each secret separately, never reuse one across two variables:
#   openssl rand -base64 48

# --- general ---------------------------------------------------------------
LOG_LEVEL=info

# --- database --------------------------------------------------------------
# The superuser, used only by the init scripts to create the per-schema roles.
POSTGRES_USER=vayal_admin
POSTGRES_PASSWORD=CHANGE_ME_superuser_password
POSTGRES_DB=vayal

# One login role per service, each able to reach only its own schema
# (postgres/init/01-init.sh). Postgres creates each role from these on first
# boot, and docker-compose.prod.yml builds each service's connection string
# from the SAME values — so a password is written exactly once.
#
# Database passwords go inside a URL, so use hex, not base64 (whose + / =
# would need URL-encoding):   openssl rand -hex 32
PROFILE_DB_USER=vm_profile
PROFILE_DB_PASSWORD=CHANGE_ME
CATALOG_DB_USER=vm_catalog
CATALOG_DB_PASSWORD=CHANGE_ME
ORDERS_DB_USER=vm_orders
ORDERS_DB_PASSWORD=CHANGE_ME

# Analytics (CLAUDE.md §5.4), created by postgres/init/03-analytics.sh: the
# consumer's writer, the read-only reader the analytics API uses, and the
# REPLICATION login that reads the event stream. After the first migration,
# create the publication once (infra/DEPLOY.md, "Analytics (CDC)").
ANALYTICS_DB_USER=vm_analytics
ANALYTICS_DB_PASSWORD=CHANGE_ME
ANALYTICS_READER_DB_USER=vm_analytics_reader
ANALYTICS_READER_DB_PASSWORD=CHANGE_ME
EVENTS_CDC_DB_USER=vm_events_cdc
EVENTS_CDC_DB_PASSWORD=CHANGE_ME
CDC_SLOT_NAME=vayal_analytics
CDC_PUBLICATION=vayal_analytics

# Managed database only: set a full URL to replace the one built above, e.g.
#   PROFILE_DATABASE_URL=postgres://vm_profile:…@db.example.com:5432/vayal?sslmode=require&search_path=profile,public
# Also: CATALOG_, ORDERS_, EVENTS_CONSUMER_DATABASE_URL (search_path=analytics,public),
# EVENTS_CONSUMER_REPLICATION_URL (replication=database), ANALYTICS_API_DATABASE_URL.
# sslmode=disable is safe ONLY because Postgres sits on the `internal` Docker
# network with no route out. Against a managed database, use sslmode=require.

DB_MAX_CONNS=10
# Caps on a single query, a lock wait, and an abandoned open transaction.
# Without these one runaway query holds a pooled connection forever and the
# pool drains while the database looks idle.
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TX_TIMEOUT_MS=30000

# --- shared secrets --------------------------------------------------------
# Proves a caller is inside the network. Every Go service refuses requests
# without it (CLAUDE.md rule 5).
INTERNAL_SERVICE_TOKEN=CHANGE_ME_internal_token
# Signs access tokens. Rotating this signs everyone out — which is the correct
# response to a suspected leak.
JWT_SECRET=CHANGE_ME_jwt_secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
BCRYPT_COST=12

# --- public URLs -----------------------------------------------------------
# Where browsers reach the API. MUST include the /api mount point — omitting it
# silently breaks every request from all three UIs while curl against the same
# host still works.
PUBLIC_API_BASE_URL=https://api.vayalmikrogreenz.com/api
# Where vm-analytics-ui (the admin Analytics remote) is served. MUST end in "/":
# admin-ui appends remoteEntry.js, and the remote addresses its own chunks
# from it. Not in CORS_ALLOWED_ORIGINS — it only runs inside the admin page.
ANALYTICS_UI_PUBLIC_URL=https://analytics.vayalmikrogreenz.com/
# Exact origins allowed to call the API. Never "*" — these requests carry
# credentials.
CORS_ALLOWED_ORIGINS=https://vayalmikrogreenz.com,https://admin.vayalmikrogreenz.com,https://supplier.vayalmikrogreenz.com

# Loopback ports the TLS terminator proxies to.
GATEWAY_PUBLIC_PORT=8080
CLIENT_PUBLIC_PORT=8090
ADMIN_PUBLIC_PORT=8091
SUPPLIER_PUBLIC_PORT=8092
# Where the supplier UI is served. vm-profile-api builds the set-password
# links it emails to admin-created suppliers from this.
SUPPLIER_APP_URL=https://supplier.vayalmikrogreenz.com
ANALYTICS_PUBLIC_PORT=8093

# Per-IP, shared by everyone behind one address (an office, a carrier NAT).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# --- object storage --------------------------------------------------------
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=mikrogreenz
S3_ACCESS_KEY=CHANGE_ME_s3_access_key
S3_SECRET_KEY=CHANGE_ME_s3_secret_key
S3_FORCE_PATH_STYLE=true
MAX_IMAGE_BYTES=5242880
MAX_VIDEO_BYTES=52428800
MAX_MEDIA_PER_SIZE_CODE=8
MAX_SIZE_CODES_PER_PRODUCT=12
MAX_CSV_BYTES=5242880
MAX_CSV_ROWS=2000

# --- pricing ---------------------------------------------------------------
PLATFORM_FEE_BPS=300
DELIVERY_FEE_PAISE=1500
# Deducted from the SUPPLIER's payout (not added to the customer's total, the
# way PLATFORM_FEE_BPS is). 300 = 3.00%. Set to 0 to pay growers in full.
SUPPLIER_COMMISSION_BPS=300
# Our share of DELIVERY_FEE_PAISE; the rest is the courier's cost.
# 500 = Rs. 5.00 of the Rs. 15.00 collected. Must not exceed DELIVERY_FEE_PAISE.
DELIVERY_MARGIN_PAISE=500
ORDER_CUTOFF_HOUR_IST=16
RESERVATION_TTL_MINUTES=15
WALLET_MIN_TOPUP_PAISE=10000
WALLET_MAX_TOPUP_PAISE=1000000
WALLET_MAX_BALANCE_PAISE=2000000
SCHEDULE_CHARGE_LEAD_MINUTES=30
SCHEDULE_LOW_BALANCE_PAUSE_AFTER=3
SCHEDULE_RUN_INTERVAL_SECONDS=60
# How often the job checks for orders whose 4pm cutoff has passed. This is the
# worst-case lag between an order becoming due and being processed, not a
# schedule — see the Processor type in vm-orders-api/internal/api. Accepted
# range is 5-3600; anything outside it stops the service at boot.
ORDER_PROCESSOR_INTERVAL_SECONDS=60

# --- payments --------------------------------------------------------------
# LIVE keys here, not test keys. Razorpay Checkout is not switched on yet;
# leave blank until it is, and orders rest in pending_payment with the admin
# recording payments manually.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set this in the Razorpay dashboard AFTER the domain is live, pointing at
# https://api.<your-domain>/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

# --- email -----------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Vayalavan <no-reply@vayalmikrogreenz.com>"
SUPPORT_EMAIL=vayal.mikrogreenz@gmail.com

# --- frontend --------------------------------------------------------------
VITE_APP_NAME="Vayalavan"
