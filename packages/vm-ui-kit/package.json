{
  "name": "@vayal/ui-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared React components, theme tokens, logo and API client for the three Vayal UIs.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tailwind-preset": "./tailwind-preset.js",
    "./styles.css": "./src/theme/tokens.css",
    "./favicon.svg": "./src/logo/favicon.svg"
  },
  "files": [
    "dist",
    "tailwind-preset.js",
    "src/theme/tokens.css",
    "src/logo/favicon.svg"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
