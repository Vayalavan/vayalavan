# Expo / React Native build state.
#
# android/ and ios/ are generated by `expo prebuild` from app.config.ts. They
# are deliberately NOT committed: app.config.ts is the source of truth, and a
# committed native project drifts from it the first time someone edits an
# Info.plist by hand instead of the config.
.expo/
android/
ios/
dist/
web-build/
expo-env.d.ts

node_modules/
*.tsbuildinfo

# EAS
.easignore

# Native build artefacts, if a prebuild is left in place locally
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

.DS_Store
